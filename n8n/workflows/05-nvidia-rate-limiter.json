      "name": "LIMITER — Check 55 RPM Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The core reports when the earliest capacity returns (rolling window / cooldown / in-flight cap).\nconst d = $input.first().json;\nconst hint = Number(d.retry_after_ms ?? 1000);\nconst jitter = Math.random() * 0.3;\nconst wait_s = Math.min(10, Math.max(0.25, hint / 1000 + jitter));\nreturn [{ json: { reason: d.reason ?? \"capacity\", retry_after_ms: hint, queue_depth: d.queue_depth ?? null, wait_s: Math.round(wait_s * 100) / 100 } }];"
      }
    },
