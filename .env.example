# ApexWeb OS configuration. Copy to .env (never commit .env) and fill in.
# Every *secret* below can instead be supplied as a file: set NAME_FILE=/run/secrets/name
# (e.g. NVIDIA_API_KEY_1_FILE) to use Docker/Kubernetes secrets.

# --- Core API -----------------------------------------------------------------
# Bearer token for the API and dashboard (>= 24 chars):  openssl rand -hex 32
APEXWEB_API_TOKEN=
APEXWEB_PORT=8080
# internal = in-process worker; n8n = every step runs through the n8n workflows
EXECUTION_DRIVER=n8n
# assist | semi | autopilot  (which approval gates are on by default)
APEXWEB_DEFAULT_MODE=semi
MAX_CONCURRENT_TASKS=8
MAX_FIX_CYCLES=2
# Optional second folder with agents/ skills/ workflows/ tools/ providers/ memory/ qa/
# APEXWEB_EXTENSIONS_DIR=/extensions

# --- Postgres (docker compose) ------------------------------------------------
POSTGRES_PASSWORD=
# Outside compose, point the core at Postgres directly:
# DATABASE_URL=postgres://apexweb:password@localhost:5432/apexweb

# --- NVIDIA inference -----------------------------------------------------------
# One key per variable. Keys are held only in memory, masked everywhere they are
# shown (nvapi-…abcd) and never written to logs, workflow JSON or agent messages.
NVIDIA_API_KEY_1=
NVIDIA_API_KEY_2=
NVIDIA_API_KEY_3=
NVIDIA_API_KEY_4=
# Optional per-key model allowlist (comma separated model ids):
# NVIDIA_API_KEY_1_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Local safety ceiling per key per rolling window. 55 is the hard maximum; lower is allowed.
NVIDIA_RPM_PER_KEY=55
NVIDIA_RATE_WINDOW_MS=60000
NVIDIA_MAX_INFLIGHT_PER_KEY=8
NVIDIA_REQUEST_TIMEOUT_MS=180000
# health-weighted-headroom (default) | weighted-least-loaded
NVIDIA_KEY_STRATEGY=health-weighted-headroom
# Check the registry against the live model catalog at startup
NVIDIA_DISCOVER_MODELS=true

# --- n8n control plane ----------------------------------------------------------
# Shared secret n8n sends to the core (header X-ApexWeb-Webhook-Secret) and the
# core sends to n8n webhooks:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=
# n8n's own credential-store encryption key (keep it stable):  openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_VERSION=2.40.5
N8N_PUBLIC_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# --- Research -------------------------------------------------------------------
# Web search provider: none | searxng | brave. With "none", research agents work
# only from supplied URLs/files and say so; nothing is invented.
RESEARCH_SEARCH_PROVIDER=none
# With `docker compose --profile search up -d`:
# RESEARCH_SEARCH_PROVIDER=searxng
# SEARXNG_URL=http://searxng:8080
# SEARXNG_SECRET=
# BRAVE_API_KEY=
RESEARCH_ALLOW_WEB_FETCH=true

# --- Obsidian --------------------------------------------------------------------
# Absolute path of your Obsidian vault on this computer. ApexWeb writes its notes
# into <vault>/ApexWeb/ and reads your other notes (read-only) as agent context.
# Windows example: C:/Users/you/Documents/ApexWeb Vault
OBSIDIAN_VAULT_HOST_PATH=
